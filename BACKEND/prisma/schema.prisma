generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Models ─────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  phone           String           @unique
  passwordHash    String
  role            Role             @default(USER)
  isActive        Boolean          @default(true)
  tokenVersion    Int              @default(0)
  createdAt       DateTime         @default(now())
  
  busBookings     BusBooking[]
  packageBookings PackageBooking[]
  supportTickets  SupportTicket[]
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

model Admin {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
}

enum BusStatus {
  Active
  In_Maintenance
  Retired
}

model Bus {
  id           String    @id @default(uuid())
  plateNumber  String    @unique
  type         String
  totalSeats   Int
  amenities    Json
  status       BusStatus @default(Active)
  lastServiced DateTime?
  busStyle     String?
  images       Json?

  trips        Trip[]
}

model Route {
  id             String   @id @default(uuid())
  originCity     String
  destinationCity String
  waypoints      String[]
  distanceKm     Int

  trips          Trip[]
}

enum TripStatus {
  Scheduled
  On_Time
  Delayed
  Completed
  Cancelled
}

model Trip {
  id                String     @id @default(uuid())
  busId             String
  routeId           String
  departureDatetime DateTime
  arrivalDatetime   DateTime
  baseFare          Decimal    @db.Decimal(10, 2)
  status            TripStatus @default(Scheduled)
  seatPricingConfig Json?      // e.g. { "L1": 850, "L2": 700, "U1": 650, "_tier_upper": 650, "_tier_lower": 750 }
  seatStatuses      Json?      // e.g. { "L4": "ladies", "L9": "blocked" }

  bus               Bus        @relation(fields: [busId], references: [id])
  route             Route      @relation(fields: [routeId], references: [id])
  bookings          BusBooking[]
  seatAllocations   BusBookingSeat[]
}

enum BookingStatus {
  Pending
  Confirmed
  Cancelled
  Refunded
}

model BusBooking {
  id           String        @id
  userId       String
  tripId       String
  seatNumbers  String[]
  totalAmount  Decimal       @db.Decimal(10, 2)
  status       BookingStatus @default(Pending)
  bookingDate  DateTime      @default(now())
  passengers   Json?
  contact      Json?
  options      Json?
  requestKey   String?       @unique

  user         User          @relation(fields: [userId], references: [id])
  trip         Trip          @relation(fields: [tripId], references: [id])
  seatAllocations BusBookingSeat[]
}

// One row per booked seat gives PostgreSQL a real uniqueness constraint for
// concurrent checkout requests. The legacy seatNumbers array is retained for
// API compatibility and printable tickets.
model BusBookingSeat {
  id         String     @id @default(uuid())
  tripId     String
  bookingId  String
  seatNumber String

  trip       Trip       @relation(fields: [tripId], references: [id])
  booking    BusBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([tripId, seatNumber])
  @@index([bookingId])
}

enum PackageCategory {
  Domestic
  International
  Spiritual
}

model TourPackage {
  id             String          @id @default(uuid())
  title          String
  category       PackageCategory
  pricePerPerson Decimal         @db.Decimal(10, 2)
  durationDays   Int
  itinerary      Json
  isActive       Boolean         @default(true)

  bookings       PackageBooking[]
}

model PackageBooking {
  id             String        @id @default(uuid())
  userId         String
  packageId      String
  travelersCount Int
  travelDate     DateTime
  totalAmount    Decimal       @db.Decimal(10, 2)
  status         BookingStatus @default(Pending)
  bookingDate    DateTime      @default(now())
  travelers      Json?
  contact        Json?
  options        Json?
  requestKey     String?       @unique

  user           User          @relation(fields: [userId], references: [id])
  package        TourPackage   @relation(fields: [packageId], references: [id])
}

model Offer {
  id                  String   @id @default(uuid())
  code                String   @unique
  discountPercentage  Int
  maxDiscountAmount   Decimal  @db.Decimal(10, 2)
  validUntil          DateTime
  isActive            Boolean  @default(true)
}

enum TicketStatus {
  Open
  In_Progress
  Resolved
  Closed
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  subject   String
  message   String
  status    TicketStatus @default(Open)
  createdAt DateTime     @default(now())

  user      User         @relation(fields: [userId], references: [id])
}
