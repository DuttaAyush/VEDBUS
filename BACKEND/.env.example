# ─────────────────────────────────────────────────────────────────
# VEDBUS / YATRABUS Backend — Environment Configuration
# Copy this file to .env and fill in real credentials.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── 1. Server Configuration ───────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── 2. Database (PostgreSQL via Neon / Prisma) ────────────────────
# Pooled connection string (recommended for production API & serverless)
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-spring-lab-b86bw89t-pooler.c-14.us-east-1.aws.neon.tech/VEDBUS?sslmode=require"
# Direct / Unpooled connection string (required for Prisma migrations & Prisma studio)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:PASSWORD@ep-spring-lab-b86bw89t.c-14.us-east-1.aws.neon.tech/VEDBUS?sslmode=require"

# ── 3. JWT Authentication ─────────────────────────────────────────
# Use cryptographically secure random strings (minimum 64 characters)
JWT_ACCESS_SECRET="CHANGE_ME_ACCESS_LONG_RANDOM_SECRET_KEY_MIN_64_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_LONG_RANDOM_SECRET_KEY_MIN_64_CHARS"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ── 4. CORS Allowed Origins ───────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# ── 5. Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── 6. Redis Distributed Locking & Cache (Optional / Future) ──────
# If omitted or offline, the backend automatically uses its resilient In-Memory lock engine
# Local: redis://localhost:6379 | Upstash: rediss://default:TOKEN@ENDPOINT.upstash.io:6379
REDIS_URL=
REDIS_TLS_URL=

# ── 7. Payment Gateways (Future / Production Setup) ───────────────
# Razorpay (Primary India Bus & Tour Booking Gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PhonePe Payment Gateway (Alternative UPI Gateway)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT

# Stripe (Optional International Card Processing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── 8. SMS & OTP Verification Providers (Future Setup) ────────────
SMS_PROVIDER=LOCAL_MOCK
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── 9. Transactional Email & E-Tickets (Future Setup) ─────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="YatraBus Bookings <no-reply@yatrabus.com>"

# ── 10. Cloud Media & Bus Gallery Storage (Future Setup) ──────────
# Cloudinary (Bus fleet pictures, seat layout diagrams, user avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 (Alternative media / invoice storage)
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── 11. GPS / IoT Bus Live Tracking (Future Setup) ────────────────
GPS_TRACKER_PROVIDER=SIMULATED
GPS_TRACKER_API_KEY=
GPS_TRACKER_ENDPOINT=

# ── 12. Super Admin Credentials (Single Root Admin) ───────────────
SUPER_ADMIN_EMAIL="superadmin@yatrabus.in"
SUPER_ADMIN_PASSWORD="CHANGE_ME_TO_SUPER_SECURE_PASSWORD"

